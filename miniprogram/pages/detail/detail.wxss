.big {
  width: 100%;
  height: 520rpx;
  background: #000;
  border-radius: 16rpx;
  image-rendering: pixelated;
  margin-bottom: 16rpx;
}

.progress {
  position: relative;
  height: 40rpx;
  background: #1c1c1e;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 16rpx 0 8rpx;
}

.bar {
  height: 100%;
  background: linear-gradient(90deg, #07c160, #10aeff);
  transition: width 0.15s linear;
}

.pct {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
}
