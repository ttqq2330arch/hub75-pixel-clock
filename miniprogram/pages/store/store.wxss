.cats { white-space: nowrap; margin-bottom: 16rpx; }
.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  background: #222;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #ccc;
}
.chip.on { background: #2b6cff; color: #fff; }

.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.card {
  width: calc(33.33% - 11rpx);
  background: #1b1b1b;
  border-radius: 16rpx;
  padding: 12rpx;
  box-sizing: border-box;
  text-align: center;
}
.cv {
  width: 100%;
  height: 200rpx;
  background: #000;
  border-radius: 10rpx;
  image-rendering: pixelated;
}
.name { display: block; font-size: 24rpx; margin-top: 10rpx; color: #eee; }
