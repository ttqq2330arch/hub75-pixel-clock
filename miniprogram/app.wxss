page {
  background: #111111;
  color: #f5f5f5;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.view {
  padding: 24rpx;
  box-sizing: border-box;
}
.btn {
  background: #ffc107;
  color: #1a1a1a;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  margin: 16rpx 0;
}
.btn.ghost {
  background: #222;
  color: #f5f5f5;
  border: 1rpx solid #444;
}
.muted { color: #888; font-size: 24rpx; }
.title { font-size: 34rpx; font-weight: 600; margin: 8rpx 0 16rpx; }
