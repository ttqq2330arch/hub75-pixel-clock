<?xml version="1.0" encoding="utf-8"?>
<!--
  板子是局域网内明文 HTTP（http://192.168.x.x/），Android 9+ (targetSdk>=28) 默认禁止明文。

  ⚠️ 关键点：network-security-config 的 <domain> 按【主机名/域名后缀】匹配，
  它【不是】CIDR 网段！写 <domain>192.168.1.0</domain> 不会匹配 192.168.1.46，
  运行时会被系统直接拒绝：
      java.io.IOException: Cleartext HTTP traffic to 192.168.1.46 not permitted
  板子 IP 由 DHCP 分配会变，也无法穷举成 domain 列表。
  因此局域网明文只能在 base-config 层放行（这是所有 IoT 控制 APP 的标准做法）。

  公网 HTTPS 仍然照常校验系统 CA（trust-anchors=system），只是不再强制必须 HTTPS。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 显式列出便于阅读：以下地址类型明确允许明文 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- mDNS 主机名，如 pixelclock-02.local -->
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">pixelclock.local</domain>
    </domain-config>
</network-security-config>
